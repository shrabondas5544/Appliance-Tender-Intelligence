# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=youraddress@gmail.com
EMAIL_TO=sales-team@yourcompany.com,bidteam@yourcompany.com

# --- Database ---
# SQLite for local/dev. Swap to a Postgres URL later for VPS/cloud without code changes
# (see core/db.py — it already speaks SQLAlchemy-style URLs).
DATABASE_URL=sqlite:///data/tenders.db

# --- App behavior ---
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=2
